{
  "name": "s3-test",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "compile": "ts-auto-guard --debug && tsc",
    "watch": "tsc -w",
    "prestart": "npm run compile",
    "start": "node dist/src/index.js",
    "lint": "eslint --ext .ts ./",
    "build": "npm run clean && npm run compile && npm run build.prepare && npm run build.zip",
    "build.prepare": "del-cli dist/test && cp package.json package-lock.json dist && cd dist && npm ci --only=production && cd ..",
    "build.zip": "cd dist && bestzip ../build.zip . && cd ..",
    "clean": "del-cli dist build.zip"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mux/mux-node": "^14.0.1",
    "aws-sdk": "^2.1354.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.68",
    "@types/cors": "^2.8.9",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/ramda": "^0.31.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "bestzip": "^2.1.7",
    "del-cli": "^7.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "ts-auto-guard": "^5.0.0",
    "typescript": "^6.0.0"
  }
}
